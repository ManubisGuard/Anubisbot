# Staging control bot only. Never commit a real token.
MANUBISGUARD_TEST_MODE=1
MANUBISGUARD_BOT_TOKEN=
MANUBISGUARD_ADMIN_IDS=
LOG_LEVEL=INFO

# Editable content persistence (use a separate namespace per bot instance).
ANUBIS_CONTENT_DB=./data/content.sqlite3
ANUBIS_MOTHER_CONTENT_NAMESPACE=example-instance
# Publishes mother-bot title/logo URL/welcome copy to the static Mini App.
ANUBIS_BRAND_JSON=./public/brand.json
# Customer deployment uses its own namespace and must not share the mother's namespace.
# ANUBIS_CUSTOMER_CONTENT_NAMESPACE=customer:example-tenant
